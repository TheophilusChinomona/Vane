# Vane runtime configuration template
# Copy to .env.local for local development or enter these keys in Dokploy's
# service Environment settings. Never commit a populated .env file.

# Dedicated PostgreSQL database created by scripts/provision-vane-beekeeper.sql
DATABASE_URL=postgresql://vane_app:<url-encoded-database-password>@100.64.182.117:5438/vane

# Generate a unique value per deployment; keep it outside Git.
BETTER_AUTH_SECRET=<long-random-secret-at-least-32-characters>

# Local development:
BETTER_AUTH_URL=http://localhost:3000
# Dokploy production: replace with the exact public HTTPS origin.
# BETTER_AUTH_URL=https://vane.example.com

# Optional: defaults to the project working directory.
# DATA_DIR=/home/vane
